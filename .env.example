# Entorno de Ejecución (development | test | production)
APP_ENV=development

# Configuración de la Base de Datos
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tutoria_db
# Usar "db" si se ejecuta con Docker Compose, o "localhost" para local
DB_HOST=db
# Puerto expuesto en el host para la base de datos (5433 en docker-compose)
DB_PORT=5433

# Seguridad y JWT (Generar una clave segura para producción)
SECRET_KEY=tu_clave_secreta_super_segura_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Orígenes permitidos para CORS, separados por coma.
# Vacío en development/test => se permite cualquier origen (Expo usa IP de LAN variables).
# OBLIGATORIO en production: el backend no arranca sin al menos un origen explícito,
# y no se acepta "*".
# Ejemplo: CORS_ALLOWED_ORIGINS=https://tutoria.unsaac.edu.pe,https://app.tutoria.unsaac.edu.pe
CORS_ALLOWED_ORIGINS=

# Clave de API de Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=tu_gemini_api_key_aqui
