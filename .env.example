# Entorno de Ejecución (development | test | production)
APP_ENV=development

# Configuración de la Base de Datos
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tutoria_db
# Usar "db" si se ejecuta con Docker Compose, o "localhost" para local
DB_HOST=db
# Puerto expuesto en el host para la base de datos (5433 en docker-compose)
DB_PORT=5433

# Seguridad y JWT (Generar una clave segura para producción)
SECRET_KEY=tu_clave_secreta_super_segura_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Orígenes permitidos para CORS, separados por coma.
# Vacío en development/test => se permite cualquier origen (Expo usa IP de LAN variables).
# OBLIGATORIO en production: el backend no arranca sin al menos un origen explícito,
# y no se acepta "*".
# Ejemplo: CORS_ALLOWED_ORIGINS=https://tutoria.unsaac.edu.pe,https://app.tutoria.unsaac.edu.pe
CORS_ALLOWED_ORIGINS=

# Clave de API de Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# --- Arranque automático en Docker ---
# El entrypoint del backend aplica "alembic upgrade head" en cada arranque y luego
# siembra SOLO lo que falte: nunca sobrescribe datos existentes.

# Admin inicial. Se crea únicamente si la base no tiene ningún usuario con rol admin.
#
# Fuera de production estos valores son opcionales: si se dejan vacíos, el backend
# usa las credenciales por defecto del repositorio (admin@unsaac.edu.pe / admin123),
# para que un clon recién levantado tenga el panel accesible sin configurar nada.
#
# En production NO hay valores por defecto y estos son obligatorios: el backend se
# niega a arrancar si ADMIN_PASSWORD es una contraseña conocida o tiene menos de 12
# caracteres. Si se dejan vacíos allí, el admin se crea a mano con:
#     python -m app.create_superuser
ADMIN_EMAIL=admin@unsaac.edu.pe
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrador

# AUTO_BOOTSTRAP=0 desactiva toda la siembra automática (las migraciones igual se aplican).
AUTO_BOOTSTRAP=1

# AUTO_SEED_CORPUS=0 evita generar los embeddings del RAG al arrancar.
# Ponerlo en 0 si querés controlar manualmente el consumo de cuota de Gemini.
AUTO_SEED_CORPUS=1
